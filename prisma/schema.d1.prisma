generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/d1"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("D1_DATABASE_URL")
}

model AdminUser {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  lastLoginAt   DateTime?
  sessions      Session[]
  createdOrders Order[]      @relation("OrderCreatedBy")
  updatedOrders Order[]      @relation("OrderUpdatedBy")
  orderEvents   OrderEvent[]
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum OrderFulfillment {
  PICKUP
  DINE_IN
  DELIVERY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  REPORTED
  CONFIRMED
  REJECTED
}

enum RefundStatus {
  NOT_REQUIRED
  REQUIRED
  REFUNDED
}

enum OrderSource {
  WHATSAPP
  PUBLIC_MENU
}

enum OrderEventKind {
  ORDER_CREATED
  STATUS_TRANSITION
  PAYMENT_REPORTED
  PAYMENT_REJECTED
  PAYMENT_AND_ORDER_CONFIRMED
  PENDING_EXPIRED
  NO_SHOW_RECORDED
  REFUND_REQUIRED
  REFUNDED
}

model Order {
  id                     String             @id @default(uuid())
  orderNumber            Int                @unique
  status                 OrderStatus        @default(RECEIVED)
  fulfillment            OrderFulfillment   @default(PICKUP)
  verificationStatus     VerificationStatus @default(VERIFIED)
  verificationResolvedAt DateTime?
  paymentStatus          PaymentStatus      @default(NOT_REQUIRED)
  paymentReportedAt      DateTime?
  paymentConfirmedAt     DateTime?
  refundStatus           RefundStatus       @default(NOT_REQUIRED)
  refundRequiredAt       DateTime?
  refundedAt             DateTime?
  noShowAt               DateTime?
  source                 OrderSource        @default(WHATSAPP)
  customerName           String?
  customerPhone          String?
  tableLabel             String?
  notes                  String?
  deliveryAddress        String?
  deliveryReference      String?
  deliveryFeeAmount      Int                @default(0)
  transferHolderName     String?
  subtotalAmount         Int
  adjustmentAmount       Int                @default(0)
  totalAmount            Int
  cancellationReason     String?
  confirmedAt            DateTime?
  closedAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  clientReference        String?            @unique
  publicTrackingToken    String?            @unique
  createdById            String?
  updatedById            String?
  createdBy              AdminUser?         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy              AdminUser?         @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  lines                  OrderLine[]
  events                 OrderEvent[]

  @@index([status, createdAt])
  @@index([verificationStatus, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillment, status, createdAt])
  @@index([customerPhone])
}

model OrderLine {
  id                String   @id @default(uuid())
  orderId           String
  productId         String?
  productName       String
  unitPriceAmount   Int
  quantity          Int
  modifiersSnapshot Json?
  note              String?
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id         String       @id @default(uuid())
  sequence   BigInt       @unique
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  kind       OrderEventKind @default(STATUS_TRANSITION)
  createdAt  DateTime     @default(now())
  actorId    String?
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      AdminUser?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MenuSettings {
  id                String   @id @default(uuid())
  businessName      String
  whatsappPhone     String
  whatsappMessage   String
  currency          String   @default("ARS")
  acceptingOrders   Boolean  @default(true)
  statusMessage     String?
  weeklySchedule    Json?
  deliveryEnabled   Boolean  @default(false)
  deliveryFeeAmount Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model Category {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  active     Boolean   @default(true)
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@index([active, sortOrder])
}

model Product {
  id             String                 @id @default(uuid())
  categoryId     String
  name           String
  description    String?
  priceAmount    Int
  imageKey       String?
  imageAlt       String?
  available      Boolean                @default(true)
  published      Boolean                @default(true)
  featured       Boolean                @default(false)
  sortOrder      Int                    @default(0)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  category       Category               @relation(fields: [categoryId], references: [id])
  modifierGroups ProductModifierGroup[]
  orderLines     OrderLine[]

  @@index([categoryId, published, sortOrder])
  @@index([featured, published])
}

model ModifierGroup {
  id        String                 @id @default(uuid())
  name      String
  active    Boolean                @default(true)
  sortOrder Int                    @default(0)
  options   ModifierOption[]
  products  ProductModifierGroup[]
}

model ModifierOption {
  id        String        @id @default(uuid())
  groupId   String
  name      String
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, active, sortOrder])
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  required        Boolean       @default(false)
  minSelections   Int?
  maxSelections   Int?
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
}
